{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 2,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "terminals_file": {
      "type": "string",
      "minLength": 1
    },
    "journey_model_file": {
      "type": "string",
      "minLength": 1
    },
    "detectors_file": {
      "type": "string",
      "minLength": 1
    },
    "additional_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "defaults": {
      "type": "object",
      "properties": {
        "start_time_seconds": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 86400
        },
        "step_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5
        }
      },
      "required": [
        "start_time_seconds",
        "step_seconds"
      ],
      "additionalProperties": false
    },
    "traffic_lights_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "format_version",
    "id",
    "name",
    "network",
    "terminals_file",
    "journey_model_file",
    "defaults"
  ],
  "additionalProperties": false
}
